# Runway configuration
#
# Copy this file to .env and adjust the values for your host:
#   cp .env.example .env
#
# .env is gitignored — never commit it. When running under systemd the file is
# loaded via EnvironmentFile= (see scripts/runway.service).

# Port to listen on
PORT=8080

# SQLite database path. Keep it outside the checkout so deploys/updates never
# touch your data (e.g. /var/lib/runway/runway.db or ~/runway-data/runway.db).
DB_PATH=./data/runway.db

# Root directory where Runway clones the repos it runs workflows for.
REPOS_ROOT=./data/repos

# Optional: GLOBAL secrets file (KEY=value lines) merged into every run.
# Per-repo and per-environment secrets are managed in the UI / API instead
# and override these. Seeded on first boot; change via Settings afterwards.
# SECRETS_FILE=/path/to/.secrets

# Master key encrypting per-repo secrets at rest (64 hex chars, e.g. from
# `openssl rand -hex 32`). If unset, a key is generated on first boot and
# stored next to the database as secrets.key (0600) — back it up; without it
# stored secrets cannot be decrypted.
# RUNWAY_SECRETS_KEY=

# Initial admin password, used ONLY on first boot to seed the admin user
# (username "admin", with a forced password change on first login).
# After first boot this value has no effect — change passwords via the UI.
# ADMIN_PASSWORD=change-me

# Runner-label → Docker-image mappings passed to act as -P flags, one
# "label=image" pair per entry, comma-separated (the Settings UI accepts one
# per line instead). Map every runs-on label your workflows use. Seeded on
# first boot; manage via Settings afterwards.
# ACT_PLATFORM_MAPPINGS=ubuntu-latest=catthehacker/ubuntu:act-22.04,self-hosted=myregistry/runner:latest

# Resource caps per act container. Seeded on first boot; afterwards change
# them via Settings in the UI.
DOCKER_MEMORY=2g
DOCKER_CPUS=2

# Optional: extra docker options for act job containers (volume mounts for
# deploy keys, registry certs, …). act honours only ONE --container-options
# flag, so put options here — NOT in ~/.actrc — and Runway merges them with
# the memory/CPU limits. Seeded on first boot; manage via Settings afterwards.
# ACT_CONTAINER_OPTIONS=-v /home/ci/.ssh/deploy_key:/root/.ssh/id_ed25519:ro

# Set ONLY for plain-HTTP dev/testing — allows the session cookie without TLS.
# RUNWAY_INSECURE_COOKIES=true
